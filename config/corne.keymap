#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <behaviors/unicode.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <zmk-helpers/key-labels/42.h>
#include <zmk-helpers/helper.h>

#include "behaviors/autoshift.dtsi"
#include "behaviors/bluetooth.dtsi"
#include "behaviors/homerowmods.dtsi"
#include "behaviors/layer-switching.dtsi"


/**
 * Layers
 *
 * The following icons from a Nerd Font
 * are the symbolid representation of layers and actions on layers.
 *
 * 󰱞   Close current layer, return to base layer
 *
 * 󰪸   Typing layer
 * 󰎢   Base layer
 * 󰎥   Numbers
 * 󰎨   Symbols
 * 󰼄   Media
 * 󱊇   System
 *
 * 󱅅   *unused*
 * 󱏦   *unused*
 * 󱥭   *unused*
 */
#define L_BASE     0
#define L_ENTHIUM  L_BASE
#define L_KVANT    1
#define L_NUMBERS  2
#define L_SYMBOLS  2
#define L_NUMSYM   2
#define L_SYSTEM   3

#include "keys.dtsi"
#include "layouts/enthium.dtsi"
#include "layouts/kvant.dtsi"
#include "layouts/numbers.dtsi"
#include "layouts/system.dtsi"


&caps_word {
  continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&uc {
    default-mode = <UC_MODE_MACOS>;
    minimum-length = <4>; // MacOS expects exactly 4-key long sequences
};


/ {
    keymap {
        compatible = "zmk,keymap";

        // Enthium is an alternative layout layer
        // optimised for more comfortable typing and Vim-usage
        enthium_layer {
            display-name = "Enthium";
            bindings = <ENTHIUM>;
        };

        // Kvant is an alternative layout for Ukrainian
        kvant_layer {
            display-name = "Kvant";
            bindings = <KVANT>;
        };
    };
};

#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH) \
    ZMK_LAYER(name,                                          \
        LT RT                                                \
        LM RM                                                \
        LB RB                                                \
        LH RH                                                \
    )

#define ____ &trans
#define NONE &none

ZMK_BASE_LAYER(Numbers,
//╭────────┲━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┓  ┏━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┱────────╮ //
     ____     ____    &kp N7   &kp N4   &kp N1    ____  ,     ____     ____     ____     ____     ____     ____  ,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
     ____    &kp N0  LHM3(N8) LHM2(N5) LHM1(N2)   ____  ,     ____     ____     ____     ____     ____     ____  ,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
     ____     ____    &kp N9   &kp N6   &kp N3    ____  ,     ____     ____     ____     ____     ____     ____  ,
//╰────────┺━━━━━━━━┻━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┩  ┡━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┻━━━━━━━━┹────────╯ //
                                ____    &kp DOT   ____  ,     ____     ____     ____
//                           ╰────────┴────────┴────────╯  ╰────────┴────────┴────────╯                            //
)

/ {
    keymap {
        compatible = "zmk,keymap";

        system_layer {
            display-name = "System";
            bindings = <SYSTEM>;
        };
    };
};


// Combo keys
// -----------------------------------------------------------------------------
// Unfortunately, there is just that much keys one can use on a small keyboard,
// and not all the functionalities I want for my base layer fit on a 42-keys
// keyboard. The solution for that is to use Combo keys, so I can make two keys
// that make sense to be pressed together, to behave in a different way.
//
// Notice that Combo keys require the keys to be defined as numbers
// representing their physical position in the keyboard. Because of that, each
// keyboard mapping will have to define a macro for each combo on this layout.
// The names of these macros should follow the following syntax:
//
// COMBO_KEY_<combo-name>
#define COMBO_KEY_CAPS_WORD <LM1 RM1>
/ {
    combos {
        compatible = "zmk,combos";

        // Turn on CAPS_WORD when pressing both shift keys together.
        combo_caps_word {
            timeout-ms = <75>;
            key-positions = COMBO_KEY_CAPS_WORD;
            layers = <L_ENTHIUM L_KVANT>;
            bindings = <&caps_word>;
        };
    };
};

/*                     KEY POSITIONS

  ╭─────────────────────────╮ ╭─────────────────────────╮
  │ LT5 LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 RT5 │
  │ LM5 LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 RM5 │
  │ LB5 LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 RB5 │
  ╰───────────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────────╯
              ╰─────────────╯ ╰─────────────╯ */

#define COMBO_TERM_FAST 20
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

// (Curly) braces
ZMK_COMBO(lbrc, &kp LBRC, RT1 RT2, L_BASE, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc, &kp RBRC, RT2 RT3, L_BASE, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// (Square) brackets
ZMK_COMBO(lbkt, &kp LBKT, RB1 RB2, L_BASE, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt, &kp RBKT, RB2 RB3, L_BASE, COMBO_TERM_FAST, COMBO_IDLE_FAST)


// Layer switching
// -----------------------------------------------------------------------------
/ {
    behaviors {
        // Tap:        Sticky Number-Symbol Layer
        // Shift-tap:  -
        // Double-tap: Toggle Number-Symbol Layer
        // Hold:       -
        // Morph:      -
        stgl_numsym: sticky_or_toggle_layer_numsym {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sl L_NUMSYM>, <&tog L_NUMSYM>;
        };
    };
};
