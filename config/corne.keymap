     ____     ____    SKM(3)   SKM(2)   SKM(1)    ____  ,  &kp PG_DN  C_LEFT   C_DOWN   C_RIGHT &kp RET    ____  ,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
     ____     ____     ____     ____     ____     ____  ,     ____     ____     ____     ____     ____     ____  ,
//╰────────┺━━━━━━━━┻━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┩  ┡━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┻━━━━━━━━┹────────╯ //
                               CANCEL    ____     ____  ,     ____     ____     ____
