/**
 * Layers
 *
 * The following icons from a Nerd Font
 * are the symbolid representation of layers and actions on layers.
 *
 * 󰱞   Close current layer, return to base layer
 *
 * 󰪸   Typing layer
 * 󰎢   Base layer
 * 󰎥   Numbers
 * 󰎨   Symbols
 * 󰼄   Media
 * 󱊇   System
 *
 * 󱅅   *unused*
 * 󱏦   *unused*
 * 󱥭   *unused*
 */
#define L_BASE     0
#define L_ENTHIUM  L_BASE
#define L_KVANT    1
#define L_NAV      2
#define L_NUMBERS  3
#define L_SYMBOLS  3
#define L_NUMSYM   3
#define L_SYSTEM   4

// Keys require layer definitions
#include "keys.dtsi"

#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH) \
    ZMK_LAYER(name,                                          \
        LT RT                                                \
        LM RM                                                \
        LB RB                                                \
        LH RH                                                \
    )

#define ____ &trans
#define NONE &none


&caps_word {
  continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&uc {
    default-mode = <UC_MODE_MACOS>;
    minimum-length = <4>; // MacOS expects exactly 4-key long sequences
};

&mt { MT_CORE };

/**
 * The Base Layer — Enthium
 *
 * The layout was designed by Suraj N. Kurapati (@sunaku)
 * originally in 2024 and reviewed multiple times by 30 January 2026,
 * when the latest Enthium v14 was published.
 *
 * Find out more about the layout at
 *   https://sunaku.github.io/enthium-keyboard-layout.html
 *   https://layouts.wiki/layouts/2026/enthium/
 *
 * The layout below is my adaptation of the Enthium v14 to Corne 3×6.
 * I originally started with Enthium v14, then tried v12, and suddenly,
 * found reasonable to stick with the latest version.
 * I have been finding unlogical having W on right pinky for the Vim uses:
 * the 'change word' (`ciw`, `caw`) and 'delete word' (`diw`, `daw`) motions
 * are very common and I use them a lot.
 */
#define C_NUM SMART_NUM
#define C_SYS &mo L_SYSTEM
ZMK_BASE_LAYER(Enthium,
//╭────────┲━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┓  ┏━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┱────────╮ //
    C_SYS    &kp Q    &kp Y    &kp O    &kp U  &kp EQUAL,    &kp X    &kp L    &kp D    &kp P    &kp Z     NONE  ,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
    &kp B    &kp C   LHM3(I)  LHM2(A)  LHM1(E) &kp MINUS,    &kp K   RHM1(H)  RHM2(T)  RHM3(N)   &kp S    &kp W  ,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
     NONE    &kp SQT &kp COMMA &kp DOT &kp SEMI &kp FSLH,    &kp J    &kp M    &kp G    &kp F    &kp V     NONE  ,
//╰────────┺━━━━━━━━┻━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┩  ┡━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┻━━━━━━━━┹────────╯ //
                              &kp ESC   C_SPC    C_NAV  ,    C_NUM    RHM5(R) &kp BSPC
//                           ╰────────┴────────┴────────╯  ╰────────┴────────┴────────╯                            //
)

/**
 * The Kvant layout
 *
 * The layout was designed by Giorgi Chavchanidze.
 *
 * Find out more about the layout at
 *   https://lykt.xyz/kvant/
 *
 * This is my adaptation to Corne, including some letter switches
 * to align also with the underneeth Enthium layer.
 */

// Shorter definition for Й
#define UC_UK_J   UC_UK_I_SHORT
#define UC_UK_YE  UC_UK_IE

#define UK(LETTER_NAME) &uc UC_UK_##LETTER_NAME

ZMK_BASE_LAYER(Kvant,
//╭────────┲━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┓  ┏━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┱────────╮ //
    UK(F)    UK(SH)   UK(Z)    UK(E)    UK(U)    UK(YU) ,    UK(B)     UK(P)   UK(R)    UK(M)    UK(ZH) &kp MINUS,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
    UK(SCH)  UK(D)    UK(S)    UK(I)    UK(A)    UK(Y)  ,    UK(K)     UK(V)   UK(N)    UK(T)    UK(L)    UK(TS) ,
//├────────╊━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━┫  ┣━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╋━━━━━━━━╉────────┤ //
     ____  &kp COMMA  UK(CH)  UK(SOFT)  UK(YA)   UK(YI) ,    UK(H)     UK(J)   UK(YE)   UK(KH)   &kp DOT   UK(G) ,   \
//╰────────┺━━━━━━━━┻━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┩  ┡━━━━━━━━╇━━━━━━━━╇━━━━━━━━╇━━━━━━━━┻━━━━━━━━┹────────╯ //
                                ____     ____     ____  ,     ____    UK(O)     ____
//                           ╰────────┴────────┴────────╯  ╰────────┴────────┴────────╯                            //
)

#define SKM(_N) &sk LHRM ## _N
