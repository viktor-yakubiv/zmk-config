/**
 * The Enthium layout
 *
 * The layout was designed by Suraj N. Kurapati (@sunaku)
 * originally in 2024 and reviewed multiple times by 30 January 2026,
 * when the latest Enthium v14 was published.
 *
 * Find out more about the layout at
 *   https://sunaku.github.io/enthium-keyboard-layout.html
 *   https://layouts.wiki/layouts/2026/enthium/
 *
 * The layout below is my adaptation of the Enthium v14 to Corne 3×6.
 * I originally started with Enthium v14, then tried v12, and suddenly,
 * found reasonable to stick with the latest version.
 * I have been finding unlogical having W on right pinky for the Vim uses:
 * the 'change word' (`ciw`, `caw`) and 'delete word' (`diw`, `daw`) motions
 * are very common and I use them a lot.
 *
╭────────────────── Left-side ──────────────────╮  ╭───────────────── Right-side ──────────────────╮
├───────┲━━━━━━━┳━━━━━━━┳━━━━━━━┳━━━━━━━┳━━━━━━━┪  ┢━━━━━━━┳━━━━━━━┳━━━━━━━┳━━━━━━━┳━━━━━━━┱───────┤
│       ┃   Q   ┃   Y   ┃   O   ┃   U   ┃   =   ┃  ┃   X   ┃   L   ┃   D   ┃   P   ┃   Z   ┃       │
├───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫  ┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╉───────┤
│   B   ┃ C ┊ ⌘ ┃ I ┊ ⌥ ┃ A ┊ ⌃ ┃ E ┊ ⇧ ┃   -   ┃  ┃   K   ┃ H ┊ ⇧ ┃ T ┊ ⌃ ┃ N ┊ ⌥ ┃ S ┊ ⌘ ┃   W   │
├───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫  ┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╉───────┤
│       ┃   '   ┃   ,   ┃   .   ┃   ;   ┃   /   ┃  ┃   J   ┃   M   ┃   G   ┃   F   ┃   V   ┃       │
╰───────┺━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛  ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┹───────╯
                        ┌───────┬───────┬───────┐  ┌───────┬───────┬───────┐
                        │ ⎋ ┊   │   ␣   │ 󰎥 ┊ ⌘ │  │ ⏎ ┊ ⌘ │   R   │ ⌫ ┊ 󰎨 │
                        ╰───────┴───────┴───────╯  ╰───────┴───────┴───────╯
 */

#pragma once

// The “magic command” or “magic escape” key
// Vim+Mac inspired: works as the Command key when hold,
// or as the Escape key when tapped,
// essentially moving Vim to the command mode
#define VIMCMD &mt LCMD ESC

// Language switcher (toggle)
// Toggles Ukrainian on top of the base layer
#define LNGSW  &tog L_KVANT

#define ENTHIUM \
    &mo L_SYSTEM  &kp Q   &kp Y     &kp O   &kp U     &kp EQUAL     &kp X   &kp L   &kp D   &kp P   &kp Z   &none \
    &kp B   LHM4(C) LHM3(I)   LHM2(A) LHM1(E)   &kp MINUS     &kp K   RHM1(H) RHM2(T) RHM3(N) RHM4(S) &kp W    \
    LNGSW   &kp SQT &kp COMMA &kp DOT &kp SEMI  &kp FSLH      &kp J   &kp M   &kp G   &kp F   AS(V)   &none  \
                              &kp ESC &kp SPACE HYPER_NUM     RHM5(RET) &kp R   &kp BSPC
